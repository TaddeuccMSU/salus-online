# Optional: a free MapTiler Cloud key (https://cloud.maptiler.com) unlocks MapTiler
# satellite + streets styles. Without it the app uses keyless OpenFreeMap + Esri imagery.
VITE_MAPTILER_KEY=

# Optional: default colour scheme for the bars, 'green' (default, white on Spartan Green) or 'white'.
# Users can still flip it with the toggle in the app bar.
VITE_UI_THEME=
